# Copy to .env.local (gitignored via *.local). No secrets belong here.

# Optional. API base URL used by the browser. Default: /api (proxied by the Vite dev server).
# An absolute URL would require CORS on the API, which is not configured.
# VITE_API_BASE_URL=/api

# Optional. Dev server only: where Vite proxies /api. Default: https://localhost:7030
# API_PROXY_TARGET=https://localhost:7030
